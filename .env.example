# GEMINI_API_KEY: Required for Gemini AI API calls on server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional server/client default fallback key for OpenRouter models.
OPENROUTER_API_KEY=""

# OPENAI_API_KEY: Optional fallback key for OpenAI ChatGPT models.
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
